[MASTER]
ignore=tests,venv,env,.venv,.git,__pycache__
jobs=1

[MESSAGES CONTROL]
disable=
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    R0913,  # too-many-arguments
    R0914,  # too-many-locals
    W0212,  # protected-access

[FORMAT]
max-line-length=127

[BASIC]
good-names=i,j,k,df,X,y,ax,cm,tp,tn,fp,fn

[DESIGN]
max-args=7
max-attributes=10